```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/

# Dependencies
.venv/
venv/
node_modules/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Distribution / packaging
.dist/
.build/
develop-eggs/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.mypy_cache/
.coverage*
coverage.xml
htmlcov/
.tox/
.nox/
```